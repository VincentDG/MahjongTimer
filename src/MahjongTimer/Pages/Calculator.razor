@using MahjongTimer.Game
@implements IAsyncDisposable
@inject IJSRuntime JS

@* Full-screen hand calculator, drawn rotated 90° so it reads in landscape while the app stays
   portrait-locked. Fields are plain boxes, not inputs, so the phone keyboard never opens. *@
<div class="calculator @(_onConditions ? "on-conditions" : "")" role="dialog" aria-label="Hand calculator">
    @if (!_onConditions)
    {
        <section class="calc-tiles">
            <div class="calc-topright">
                <span class="calc-count @(_entry.TileCount == HandEntry.TilesInWinningHand ? "ok" : "")">@_entry.TileCount / @HandEntry.TilesInWinningHand tiles</span>
                <button class="calc-close" @onclick="OnClose">Close</button>
            </div>

            <div class="calc-dora">
                @foreach (var (label, field) in new[] { ("Dora", new FieldRef(Field.Dora)), ("Ura", new FieldRef(Field.UraDora)) })
                {
                    var text = Mpsz.Read(TextOf(field));
                    <span class="calc-label">@label</span>
                    <span class="calc-slots @Dim(field)">
                        @for (var t = 0; t < Math.Min(text.Tiles.Count, HandEntry.MaxIndicators); t++)
                        {
                            var at = t; var indicatorField = field;
                            <span class="calc-tap" title="Tap to remove" @onclick="() => RemoveTile(indicatorField, 0, at)"><TileView Tile="text.Tiles[at]" /></span>
                        }
                        @for (var i = text.Tiles.Count; i < HandEntry.MaxIndicators; i++) { <span class="slot"></span> }
                    </span>
                }
            </div>

            @* Tapping a tile here removes it from its field. *@
            <div class="calc-hand" style="--count:@HandLineTileCount()">
                @TileGroup(new FieldRef(Field.Closed), _entry.Closed)
                @{ var openGroups = OpenGroups().ToList(); }
                @for (var g = 0; g < openGroups.Count; g++) { @TileGroup(new FieldRef(Field.Open), openGroups[g], group: g) }
                @for (var i = 0; i < _entry.ConcealedKans.Count; i++) { @TileGroup(new FieldRef(Field.Kan, i), _entry.ConcealedKans[i], isConcealedKan: true) }
                <span class="calc-gap"></span>
                @TileGroup(new FieldRef(Field.Winning), _entry.Winning, isWinning: true)
            </div>
        </section>

        <section class="calc-fields">
            <div class="calc-row halves">
                @FieldBox("Dora", new FieldRef(Field.Dora), "grows")
                @FieldBox("Ura", new FieldRef(Field.UraDora), "grows")
            </div>
            <div class="calc-row">
                @FieldBox("Closed", new FieldRef(Field.Closed), "fill")
                <div class="calc-field plus">
                    <span class="calc-label">Kan</span>
                    <button class="calc-add" aria-label="Add concealed kan" disabled="@(_entry.ConcealedKans.Count >= 4)" @onclick="AddKan">+</button>
                </div>
                @FieldBox("Winning", new FieldRef(Field.Winning), "winning")
            </div>
            @* Concealed kans get their own row once there is one: four never fit beside Closed. *@
            @if (_entry.ConcealedKans.Count > 0)
            {
                <div class="calc-row">
                    @for (var i = 0; i < _entry.ConcealedKans.Count; i++)
                    {
                        var index = i;
                        <div class="calc-field kan">
                            <span class="calc-label">Kan</span>
                            <div class="calc-box @Active(new FieldRef(Field.Kan, index))" @onclick="() => Activate(new FieldRef(Field.Kan, index))">
                                @FieldText(new FieldRef(Field.Kan, index))
                                <button class="calc-remove" aria-label="Remove concealed kan" @onclick="() => RemoveKan(index)" @onclick:stopPropagation="true">×</button>
                            </div>
                        </div>
                    }
                </div>
            }
            <div class="calc-row">
                @FieldBox("Open", new FieldRef(Field.Open), "fill")
            </div>
        </section>

        <section class="calc-keys">
            <div class="calc-honours">
                @for (var rank = 1; rank <= 7; rank++)
                {
                    var honour = $"{rank}z";
                    <button class="calc-honour" aria-label="@honour" @onclick="() => Type(honour)">
                        <TileView Tile="new Tile(rank, 'z')" /><span>@honour</span>
                    </button>
                }
            </div>
            <div class="calc-keypad">
                @foreach (var key in new[] { "1", "2", "3", "4", "5", "6", "7", "8", "9", "0" })
                {
                    <button class="calc-key" @onclick="() => Type(key)">@key</button>
                }
                <button class="calc-key" aria-label="Delete" @onclick="Backspace">⌫</button>
                @foreach (var suit in new[] { "m", "p", "s", "z" })
                {
                    <button class="calc-key suit" @onclick="() => Type(suit)">@suit</button>
                }
                <button class="calc-key comma" aria-label="Comma" @onclick='() => Type(",")'>,</button>
            </div>
            @* Only for real mistakes, or a full 14 tiles that still isn't a hand; an unfinished hand just shows its count. *@
            @if (_entry.HasMistake || (Hand is null && _entry.TileCount == HandEntry.TilesInWinningHand))
            {
                <span class="calc-invalid">Invalid hand</span>
            }
            <button class="calc-submit" disabled="@(Hand is null)" @onclick="ShowConditions">Calculate value</button>
        </section>
    }
    else
    {
        <section class="calc-head">
            <button class="calc-back" @onclick="() => _onConditions = false">‹ Back</button>
            <div class="calc-hand small">
                @TileGroup(new FieldRef(Field.Closed), _entry.Closed, dim: false)
                @foreach (var group in OpenGroups()) { @TileGroup(new FieldRef(Field.Open), group, dim: false) }
                @for (var i = 0; i < _entry.ConcealedKans.Count; i++) { @TileGroup(new FieldRef(Field.Kan, i), _entry.ConcealedKans[i], isConcealedKan: true, dim: false) }
                <span class="calc-gap"></span>
                @TileGroup(new FieldRef(Field.Winning), _entry.Winning, isWinning: true, dim: false)
            </div>
            <button class="calc-close" @onclick="OnClose">Close</button>
        </section>

        <section class="calc-conditions">
            @{ var c = _conditions; var closedHand = Hand!.CalledSets.Count == 0; var hasKan = HasKan(); }
            <div class="calc-cond">
                <span class="calc-label">Win</span>
                <div class="calc-chips">
                    @Chip("Ron", !c.IsTsumo, () => Set(c with { IsTsumo = false }), kind: "ron")
                    @Chip("Tsumo", c.IsTsumo, () => Set(c with { IsTsumo = true }), kind: "tsumo")
                </div>
            </div>
            <div class="calc-cond">
                <span class="calc-label">Riichi</span>
                <div class="calc-chips">
                    @Chip("Riichi", c.IsRiichi, () => Set(c with { IsRiichi = !c.IsRiichi, IsDoubleRiichi = false }), !closedHand, kind: "riichi")
                    @Chip("Ippatsu", c.IsIppatsu, () => Set(c with { IsIppatsu = !c.IsIppatsu }), !(c.IsRiichi || c.IsDoubleRiichi))
                </div>
            </div>
            <div class="calc-cond">
                <span class="calc-label">Seat wind</span>
                <div class="calc-chips">
                    @foreach (var wind in Enum.GetValues<Wind>()) { @Chip(wind.ToString(), c.SeatWind == wind, () => Set(c with { SeatWind = wind })) }
                </div>
            </div>
            <div class="calc-cond">
                <span class="calc-label">Round wind</span>
                <div class="calc-chips">
                    @foreach (var wind in new[] { Wind.East, Wind.South, Wind.West }) { @Chip(wind.ToString(), c.RoundWind == wind, () => Set(c with { RoundWind = wind })) }
                </div>
            </div>
            <div class="calc-cond">
                <span class="calc-label">Honba</span>
                <div class="calc-chips">
                    @Chip("−", false, () => Set(c with { Honba = c.Honba - 1 }), c.Honba == 0)
                    <span class="calc-honba">@c.Honba</span>
                    @Chip("+", false, () => Set(c with { Honba = c.Honba + 1 }))
                </div>
            </div>
            <div class="calc-cond">
                <span class="calc-label">Rare</span>
                <div class="calc-chips">
                    @Chip("Double riichi", c.IsDoubleRiichi, () => Set(c with { IsDoubleRiichi = !c.IsDoubleRiichi, IsRiichi = false }), !closedHand)
                    @Chip("Rinshan", c.IsRinshan, () => Set(c with { IsRinshan = !c.IsRinshan }), !hasKan || !c.IsTsumo)
                    @Chip("Chankan", c.IsChankan, () => Set(c with { IsChankan = !c.IsChankan }), c.IsTsumo)
                    @Chip("Haitei", c.IsHaitei, () => Set(c with { IsHaitei = !c.IsHaitei }), !c.IsTsumo)
                    @Chip("Houtei", c.IsHoutei, () => Set(c with { IsHoutei = !c.IsHoutei }), c.IsTsumo)
                    @Chip("Tenhou", c.IsTenhou, () => Set(c with { IsTenhou = !c.IsTenhou }), !c.IsTsumo || !closedHand || !c.IsDealer)
                    @Chip("Chiihou", c.IsChiihou, () => Set(c with { IsChiihou = !c.IsChiihou }), !c.IsTsumo || !closedHand || c.IsDealer)
                </div>
            </div>
        </section>

        <section class="calc-result">
            @if (_score is { } score)
            {
                <div class="calc-scoreline">
                    @* Han and fu on top, the limit name (Mangan…) under them; a yakuman shows only its name. *@
                    <div class="calc-headline">
                        @if (score.IsYakuman) { <span>@score.LimitName</span> }
                        else
                        {
                            <span>@score.Han han @score.Fu fu</span>
                            @* The limit name, and how raw fu rounded up (the list has no total rows). *@
                            var notes = new[] { score.LimitName, score.RawFu != score.Fu ? $"fu {score.RawFu} → {score.Fu}" : null }.OfType<string>();
                            @if (notes.Any()) { <small>@string.Join(" · ", notes)</small> }
                        }
                    </div>
                    <div class="calc-points-box">
                        @* --chars lets the CSS shrink points and label together when they'd be too wide. *@
                        <div class="calc-points" style="--chars:@(score.Payment.Amount.Length + score.Payment.Label.Length + 1)">
                            <span>@score.Payment.Amount</span>
                            <span class="calc-win-type @(_conditions.IsTsumo ? "tsumo" : "")">@score.Payment.Label</span>
                            @if (_conditions.Honba > 0) { <small>incl. @_conditions.Honba honba</small> }
                        </div>
                    </div>
                </div>
                <div class="calc-lists @(score.IsYakuman ? "single" : "")">
                    <div class="calc-list">
                        @foreach (var line in score.HanLines) { @LineName(line)<span>@(score.IsYakuman ? "" : line.Value)</span> }
                    </div>
                    @if (!score.IsYakuman)
                    {
                        <div class="calc-list">
                            @foreach (var line in score.FuLines) { @LineName(line)<span>@line.Value</span> }
                        </div>
                    }
                </div>
            }
            else if (_scoreError is { } error)
            {
                <p class="calc-pending">@error</p>
            }
        </section>
    }
</div>

@code {
    private enum Field { Dora, UraDora, Closed, Winning, Open, Kan }

    /// <summary>Which text field: the kind, and for a concealed kan, which one.</summary>
    private readonly record struct FieldRef(Field Field, int KanIndex = 0);

    private const int MaxConcealedKans = 4;

    [Parameter] public EventCallback OnClose { get; set; }

    private HandEntry _entry = new();
    private FieldRef _active = new(Field.Closed);
    private int _caret; // Cursor position in the active field's text: 0 = before the first character.
    private WinConditions _conditions = new();
    private bool _onConditions;
    private IJSObjectReference? _scoring;
    private HandScore? _score;
    private string? _scoreError;

    /// <summary>The checked hand, or null while the entry is invalid. Recomputed on every render.</summary>
    private WinningHand? Hand => _entry.Read();

    private string TextOf(FieldRef field) => field.Field switch
    {
        Field.Dora => _entry.Dora,
        Field.UraDora => _entry.UraDora,
        Field.Closed => _entry.Closed,
        Field.Winning => _entry.Winning,
        Field.Open => _entry.Open,
        _ => _entry.ConcealedKans[field.KanIndex],
    };

    private void SetText(FieldRef field, string text) => _entry = field.Field switch
    {
        Field.Dora => _entry with { Dora = text },
        Field.UraDora => _entry with { UraDora = text },
        Field.Closed => _entry with { Closed = text },
        Field.Winning => _entry with { Winning = text },
        Field.Open => _entry with { Open = text },
        _ => _entry with { ConcealedKans = _entry.ConcealedKans.Select((kan, i) => i == field.KanIndex ? text : kan).ToList() },
    };

    /// <summary>Makes a field the one being typed into, with the cursor at its end.</summary>
    private void Activate(FieldRef field)
    {
        _active = field;
        _caret = TextOf(field).Length;
    }

    /// <summary>Inserts at the cursor and moves the cursor past what was typed.</summary>
    private void Type(string key)
    {
        var text = TextOf(_active);
        var at = Math.Clamp(_caret, 0, text.Length);
        SetText(_active, text.Insert(at, key));
        _caret = at + key.Length;
    }

    /// <summary>Deletes the character just before the cursor.</summary>
    private void Backspace()
    {
        var text = TextOf(_active);
        var at = Math.Clamp(_caret, 0, text.Length);
        if (at == 0) return;
        SetText(_active, text.Remove(at - 1, 1));
        _caret = at - 1;
    }

    /// <summary>Removes one tile, tapped in the tile picture, from its field.</summary>
    /// <param name="group">For the Open field: which comma-separated set the tile is in.</param>
    private void RemoveTile(FieldRef field, int group, int index)
    {
        if (field.Field == Field.Open)
        {
            var groups = OpenGroups().ToList();
            groups[group] = Mpsz.RemoveTile(groups[group], index);
            SetText(field, string.Join(",", groups.Where(text => text.Length > 0)));
        }
        else
        {
            SetText(field, Mpsz.RemoveTile(TextOf(field), index));
        }
        Activate(field);
    }

    private void AddKan()
    {
        if (_entry.ConcealedKans.Count >= MaxConcealedKans) return;
        _entry = _entry with { ConcealedKans = [.. _entry.ConcealedKans, ""] };
        Activate(new FieldRef(Field.Kan, _entry.ConcealedKans.Count - 1));
    }

    private void RemoveKan(int index)
    {
        _entry = _entry with { ConcealedKans = _entry.ConcealedKans.Where((_, i) => i != index).ToList() };
        Activate(new FieldRef(Field.Closed));
    }

    private async Task ShowConditions()
    {
        if (Hand is null) return;
        _onConditions = true;
        Set(_conditions);
        await Rescore();
    }

    /// <summary>Scores the current hand and conditions through riichi-score (wwwroot/js/scoring.js).</summary>
    private async Task Rescore()
    {
        if (Hand is not { } hand) return;
        _scoring ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/scoring.js");
        var response = await _scoring.InvokeAsync<ScoreResponse>("score", ScoreRequest.From(hand, _conditions));
        _score = response.IsValid ? HandScore.From(response, _conditions) : null;
        _scoreError = response.IsValid ? null : response.Errors.FirstOrDefault() ?? "This hand can't win as entered.";
    }

    public async ValueTask DisposeAsync()
    {
        if (_scoring is null) return;
        try { await _scoring.DisposeAsync(); } catch (JSDisconnectedException) { }
    }

    private void Set(WinConditions conditions) =>
        _conditions = conditions.FitTo(isClosed: Hand?.CalledSets.Count == 0, hasKan: HasKan());

    private bool HasKan() =>
        Hand is { } hand && (hand.ConcealedKans.Count > 0 || hand.CalledSets.Any(set => set.Kind == CalledSetKind.Kan));

    private IEnumerable<string> OpenGroups() =>
        string.IsNullOrWhiteSpace(_entry.Open) ? [] : _entry.Open.Split(',');

    /// <summary>Tiles drawn in the hand line, including pending digits, so tiles can shrink to fit.</summary>
    private int HandLineTileCount()
    {
        var fields = new[] { _entry.Closed, _entry.Winning }.Concat(OpenGroups()).Concat(_entry.ConcealedKans);
        return Math.Max(14, fields.Sum(text => { var read = Mpsz.Read(text); return read.Tiles.Count + read.PendingDigits.Count; }));
    }

    private string Active(FieldRef field) => _active == field ? "active" : "";

    private string Dim(FieldRef field) => _active == field ? "" : "dim";

    /// <summary>
    /// One field's tiles in the picture. On the input screen (<paramref name="dim"/> true) the
    /// tiles dim when their field isn't active, and tapping one removes it.
    /// </summary>
    private RenderFragment TileGroup(FieldRef field, string text, bool isWinning = false, bool isConcealedKan = false, bool dim = true, int group = 0) => __builder =>
    {
        var read = Mpsz.Read(text);
        if (read.Tiles.Count == 0 && read.PendingDigits.Count == 0) return;
        var faceDownEnds = isConcealedKan && read.Tiles.Count == 4;
        <span class="calc-group @(isWinning ? "winning" : "") @(dim ? Dim(field) : "")">
            @for (var i = 0; i < read.Tiles.Count; i++)
            {
                var at = i;
                var tile = read.Tiles[at];
                var faceDown = faceDownEnds && (at == 0 || at == 3);
                if (dim)
                {
                    <span class="calc-tap" title="Tap to remove" @onclick="() => RemoveTile(field, group, at)"><TileView Tile="tile" FaceDown="faceDown" /></span>
                }
                else
                {
                    <TileView Tile="tile" FaceDown="faceDown" />
                }
            }
            @foreach (var digit in read.PendingDigits) { <TileView Pending="digit" /> }
        </span>
    };

    private RenderFragment FieldBox(string label, FieldRef field, string kind) => __builder =>
    {
        <div class="calc-field @kind">
            <span class="calc-label">@label</span>
            <div class="calc-box @Active(field)" @onclick="() => Activate(field)">@FieldText(field)</div>
        </div>
    };

    /// <summary>
    /// A field's text. In the active field each character can be tapped to put the cursor just
    /// after it; tapping the empty part of the box (handled by the box) puts it at the end.
    /// </summary>
    private RenderFragment FieldText(FieldRef field) => __builder =>
    {
        var text = TextOf(field);
        <span class="calc-text">
            @if (_active != field)
            {
                @text
            }
            else
            {
                var caret = Math.Clamp(_caret, 0, text.Length);
                @if (caret == 0) { <span class="calc-caret"></span> }
                @for (var i = 0; i < text.Length; i++)
                {
                    var after = i + 1;
                    <span class="calc-char" @onclick="() => _caret = after" @onclick:stopPropagation="true">@text[i]</span>
                    @if (after == caret) { <span class="calc-caret"></span> }
                }
            }
        </span>
    };

    /// <summary>A toggle chip. <paramref name="kind"/> gives it its own colour when pressed (ron, tsumo, riichi).</summary>
    private RenderFragment Chip(string label, bool pressed, Action onClick, bool disabled = false, string kind = "") => __builder =>
    {
        <button class="calc-chip @kind" aria-pressed="@(pressed ? "true" : "false")" disabled="@disabled" @onclick="async () => { onClick(); await Rescore(); }">@label</button>
    };

    /// <summary>A breakdown line's name on one line: English, then the Japanese name smaller.</summary>
    private static RenderFragment LineName(ScoreLine line) => __builder =>
    {
        <span class="calc-line-name" title="@line.Name · @line.Japanese"><span>@line.Name</span><small>@line.Japanese</small></span>
    };
}
